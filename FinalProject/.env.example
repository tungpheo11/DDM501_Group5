# =============================================================================
# Credit Default Risk Scoring — environment configuration
# Copy to .env (`make setup` does this) and adjust. Never commit .env.
# Values below are LOCAL-DEVELOPMENT defaults, not production secrets.
# =============================================================================

# Runtime environment: local | docker | test  (selects configs/environments/<env>.yaml)
APP_ENV=local
LOG_LEVEL=INFO

# Project & Model
PROJECT_NAME=credit-default-risk-mlops
MODEL_NAME=credit-risk-model
MODEL_ALIAS=champion
EXPERIMENT_NAME=credit-default-risk-scoring

# Database (PostgreSQL) — change the password outside local development
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlopspass
POSTGRES_DB=credit_mlops_db
POSTGRES_PORT=15434

# MinIO Object Storage — change credentials outside local development
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_BUCKET=mlflow
MINIO_API_PORT=19040
MINIO_CONSOLE_PORT=19041

# MLflow Tracking & Registry (host-side port; containers use http://mlflow:5000)
MLFLOW_PORT=15040
# MLFLOW_TRACKING_URI=http://localhost:15040
# Comma-separated origins allowed to use the MLflow UI when it is opened by IP/domain
# instead of localhost/SSH tunnel (otherwise the UI gets 403 "Cross-origin request blocked").
# MLFLOW_CORS_ALLOWED_ORIGINS=http://203.0.113.10:15040,https://mlflow.example.com
# Local only: fall back to sqlite under mlruns/ when the tracking server is unreachable.
# MLFLOW_LOCAL_FALLBACK=true
# Optuna budget per algorithm for `make train` (default from configs/training.yaml).
# OPTUNA_N_TRIALS=20

# API Serving
API_PORT=18020
# API_URL=http://localhost:18020
REVIEW_THRESHOLD=0.30
DECLINE_THRESHOLD=0.60
# gunicorn worker processes in the api container (keep = its CPU limit, 2); 1 = single-process rollback.
# API_WORKERS=2
# Inference-log DB pool per worker (total connections <= API_WORKERS x (size + overflow)).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# API-key auth for /api/v1/* (header X-API-Key). Comma-separated list so keys can be
# rotated without downtime. Generate real keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=local-dev-key-change-me
# Key used by clients in this repo (simulator, retrain hot reload); defaults to the first API_KEYS entry.
# API_KEY=
# API_AUTH_ENABLED=true
# Log format: json (default, structured) | text (human-readable local debugging)
LOG_FORMAT=json
# HMAC key for pseudonymizing identifiers that leave the service (credit_risk.responsible_ai.privacy).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PSEUDONYMIZATION_KEY=local-dev-pseudonym-key-change-me

# Staff portal (services/staff_portal, http://localhost:18030) — demo accounts for the three roles.
# Passwords are hashed with bcrypt at startup; to keep plain passwords out of the environment set
# PORTAL_<ROLE>_PASSWORD_HASH instead (python -c "import bcrypt; print(bcrypt.hashpw(b'...', bcrypt.gensalt()).decode())").
# Change every value below outside local development.
PORTAL_PORT=18030
PORTAL_SESSION_SECRET=local-portal-session-secret-change-me
PORTAL_CSKH_USERNAME=cskh
PORTAL_CSKH_PASSWORD=Cskh@2026
PORTAL_ANALYST_USERNAME=chuyenvien
PORTAL_ANALYST_PASSWORD=RuiRo@2026
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_PASSWORD=QuanTri@2026
# Inference-log deletion is enabled only in demo mode. Default: on in the dev stack, off with the
# production overlay (make up-prod); set explicitly to override either.
# PORTAL_DEMO_MODE=true
# Scoring API key used by the portal (server-side only); defaults to API_KEY, then the first API_KEYS entry.
# PORTAL_API_KEY=
# Requests per second sent by the admin "Simulate" job.
# PORTAL_SIMULATE_RATE_PER_SECOND=20
# Secure-only session cookie (needs HTTPS or localhost); default false in dev, true in production.
# PORTAL_COOKIE_SECURE=false

# Compose profiles started by `make up` (core | monitoring | orchestration)
COMPOSE_PROFILES=core,monitoring,orchestration

# Observability
PROMETHEUS_PORT=19090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=13000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-change-me
ALERTMANAGER_PORT=19093
ALERT_WEBHOOK_PORT=19095
STATSD_EXPORTER_PORT=19102

# Drift monitor (Evidently service, services/drift_monitor)
DRIFT_MONITOR_PORT=18085
DRIFT_WINDOW_SIZE=500
DRIFT_ANALYSIS_INTERVAL_SECONDS=60

# Alerting (Alertmanager -> Telegram). Leave empty to use the internal webhook fallback
# (alert-webhook, http://localhost:19095/alerts); every alert reaches the webhook either way.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Airflow (orchestration profile) — change the password/secret outside local development.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_PORT=18080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=local-airflow-change-me
AIRFLOW_SECRET_KEY=local-airflow-secret-change-me
# Optional Fernet key for encrypting Airflow connections/variables:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
DRIFT_MONITORING_SCHEDULE="*/30 * * * *"
RETRAIN_COOLDOWN_MINUTES=60
RETRAIN_MIN_ROC_AUC=0.70
