# =============================================================================
# Credit Default Risk Scoring MLOps Environment Configuration
# =============================================================================

# Project & Model
PROJECT_NAME=credit-default-risk-mlops
MODEL_NAME=credit-risk-model
MODEL_ALIAS=champion
EXPERIMENT_NAME=credit-default-risk-scoring

# Database (PostgreSQL)
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlopspass
POSTGRES_DB=credit_mlops_db
POSTGRES_PORT=15434

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_BUCKET=mlflow
MINIO_API_PORT=19040
MINIO_CONSOLE_PORT=19041

# MLflow Tracking & Registry
MLFLOW_PORT=15040
MLFLOW_TRACKING_URI=http://mlflow:5000

# API Serving
API_PORT=18020
REVIEW_THRESHOLD=0.30
DECLINE_THRESHOLD=0.60

# Observability
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
