        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((sum(increase(credit_api_requests_total{job=\"credit-risk-api\",endpoint=~\"/api/v1/.*\",status=~\"5..\"}[1h]))) or vector(0)) / sum(increase(credit_api_requests_total{job=\"credit-risk-api\",endpoint=~\"/api/v1/.*\"}[1h]))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 0.95,
                "color": "orange"
              },
              {
                "value": 0.99,
                "color": "green"
              }
            ]
          },
          "mappings": [],
          "decimals": 2,
          "noValue": "no traffic"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
