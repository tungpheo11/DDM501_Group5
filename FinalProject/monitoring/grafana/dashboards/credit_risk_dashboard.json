{
  "id": null,
  "uid": "credit-risk-mlops",
  "title": "Credit Risk MLOps Telemetry & Drift Monitoring",
  "tags": ["mlops", "credit-risk", "evidently"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Total Prediction Requests",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(credit_prediction_requests_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Rolling Default Risk Ratio",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "expr": "credit_default_prediction_ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.3},
              {"color": "red", "value": 0.5}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Decisions Breakdown (APPROVE vs REVIEW vs DECLINE)",
      "type": "piechart",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum by (decision) (credit_prediction_requests_total)",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "p95 Inference Latency (ms)",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(credit_prediction_duration_seconds_bucket[5m])) by (le)) * 1000",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 5,
      "title": "Prediction Traffic Rate over Time",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "expr": "sum by (decision) (rate(credit_prediction_requests_total[1m]))",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Default Prediction Ratio Trend",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "expr": "credit_default_prediction_ratio",
          "legendFormat": "Risk Ratio",
          "refId": "A"
        }
      ]
    }
  ]
}
