    {
      "type": "timeseries",
      "title": "Model inference latency",
      "description": "model.predict_proba() time only (HTTP latency lives on Infra & SLA). Line = 100 ms latency budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(credit_prediction_duration_seconds_bucket{job=\"credit-risk-api\"}[2m]))) >= 0",
          "legendFormat": "p50",
          "instant": false,
          "range": true,
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(credit_prediction_duration_seconds_bucket{job=\"credit-risk-api\"}[2m]))) >= 0",
          "legendFormat": "p95",
          "instant": false,
          "range": true,
          "format": "time_series",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "transparent"
              },
              {
                "value": 0.1,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "noValue": "no observations"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "id": 14
    },
