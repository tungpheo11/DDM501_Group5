# Alertmanager configuration template, rendered by render_config.sh at
# container start. Every alert always reaches the internal webhook receiver
# (alert-webhook), so alerts are observable without a Telegram bot. When
# TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are set, the TELEGRAM blocks are kept
# and alerts are also delivered to Telegram; otherwise they are stripped.

global:
  resolve_timeout: 5m

templates:
  - /etc/alertmanager/templates/*.tmpl

route:
  receiver: webhook
  group_by: ["alertname", "severity", "component"]
  group_wait: 15s
  group_interval: 1m
  repeat_interval: 4h
  routes:
    # BEGIN_TELEGRAM
    - receiver: telegram
      continue: true
      matchers:
        - severity=~"critical|warning"
    # END_TELEGRAM
    - receiver: webhook
      matchers:
        - severity="critical"
      repeat_interval: 1h
    - receiver: webhook

inhibit_rules:
  # When the API is down, its request/model alerts are symptoms, not causes.
  - source_matchers:
      - alertname="APIDown"
    target_matchers:
      - alertname=~"HighErrorRate|HighLatencyP95|ModelNotLoaded|ModelServedFromFallback"
  # A critical alert silences a warning of the same name/component.
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: ["alertname", "component"]

receivers:
  - name: webhook
    webhook_configs:
      - url: http://alert-webhook:9095/alerts
        send_resolved: true
        max_alerts: 50
  # BEGIN_TELEGRAM
  - name: telegram
    telegram_configs:
      - bot_token_file: /tmp/alertmanager/telegram_bot_token
        chat_id: __TELEGRAM_CHAT_ID__
        send_resolved: true
        parse_mode: HTML
        message: '{{ template "telegram.credit.message" . }}'
  # END_TELEGRAM
