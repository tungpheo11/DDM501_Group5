%% System context diagram: Credit Default Risk Scoring Platform (Credit Line Management)
flowchart TB
    analyst["<b>Credit Risk Analyst</b><br/><i>[Person]</i><br/>Chuyên viên rủi ro tín dụng / quản lý hạn mức;<br/>xử lý tài khoản vùng REVIEW và danh sách<br/>cảnh báo sớm, đọc reason codes"]:::person
    mlops["<b>ML / MLOps Engineer</b><br/><i>[Person]</i><br/>Train, promote, rollback model;<br/>vận hành stack và xử lý alert"]:::person
    risk["<b>Risk &amp; Compliance Manager</b><br/><i>[Person]</i><br/>Theo dõi KPI, expected loss,<br/>fairness report và model card"]:::person

    cms["<b>Card Management System (CMS) /<br/>Mobile app backend</b><br/><i>[External System]</i><br/>Chủ thẻ gửi yêu cầu tăng hạn mức,<br/>rút tiền mặt, chuyển trả góp trên app;<br/>chờ kết quả ngay trong phiên<br/>(demo: persona simulator)"]:::external
    batch["<b>Batch limit-review job</b><br/><i>[External System]</i><br/>Chạy sau mỗi kỳ sao kê: rà soát hạn mức<br/>toàn danh mục, lập danh sách cảnh báo sớm"]:::external

    platform["<b>Credit Default Risk Scoring Platform</b><br/><i>[Software System]</i><br/>Dự báo P(default) kỳ thanh toán kế tiếp<br/>của chủ thẻ đang lưu hành; quyết định hạn mức<br/>theo cost matrix FN=10 / FP=1;<br/>giám sát drift, tự retrain qua quality gate,<br/>promote / rollback model"]:::system

    dataset["<b>UCI Credit Card Default</b><br/><i>[External Data Source]</i><br/>30.000 chủ thẻ Đài Loan 2005<br/>23 feature (hạn mức, 6 kỳ trả nợ, sao kê)<br/>+ nhãn default kỳ tới"]:::external
    github["<b>GitHub Actions + GHCR</b><br/><i>[External System]</i><br/>CI (lint, test, Trivy, smoke)<br/>CD: build image, deploy qua SSH"]:::external
    telegram["<b>Telegram Bot API</b><br/><i>[External System]</i><br/>Kênh nhận alert on-call<br/>(tùy chọn, token trong .env)"]:::external

    cms -- "Realtime:<br/>POST /api/v1/predict, /explain<br/>[HTTPS + X-API-Key, JSON]" --> platform
    batch -- "Batch sau kỳ sao kê:<br/>POST /api/v1/predict/batch<br/>(lô ≤ 500), /explain<br/>[HTTPS + X-API-Key, JSON]" --> platform
    analyst -- "Xem quyết định + reason codes<br/>[qua CMS]" --> cms
    mlops -- "Grafana, MLflow, Airflow UI, make targets<br/>[HTTPS / SSH tunnel]" --> platform
    risk -- "Business dashboard, fairness &amp; model card<br/>[HTTPS]" --> platform
    dataset -- "CSV snapshot, versioned bằng manifest hash<br/>[batch, offline]" --> platform
    github -- "Pull image theo digest, deploy.sh deploy / smoke / rollback<br/>[SSH]" --> platform
    platform -- "Alert firing / resolved, kết quả retrain<br/>[HTTPS Bot API]" --> telegram
    telegram -. "Thông báo on-call" .-> mlops

    classDef person fill:#08427B,stroke:#052E56,color:#FFFFFF,stroke-width:2px
    classDef system fill:#1168BD,stroke:#0B4884,color:#FFFFFF,stroke-width:3px
    classDef external fill:#8C8C8C,stroke:#6B6B6B,color:#FFFFFF,stroke-width:2px
