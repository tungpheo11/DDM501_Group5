[Unit]
Description=Credit Risk MLOps backup (PostgreSQL + MinIO)
Documentation=file:///opt/credit-risk/current/docs/guides/ubuntu-deployment.md
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
Group=docker
Environment=DEPLOY_ROOT=/opt/credit-risk
Environment=BACKUP_DIR=/var/backups/credit-risk
Environment=BACKUP_KEEP=7
ExecStart=/bin/bash /opt/credit-risk/current/deploy/ubuntu/backup.sh backup
